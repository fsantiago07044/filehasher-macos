{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v)",
      "Bash(git tag:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild build-for-testing:*)",
      "Bash(xcodebuild -version)",
      "Bash(xcrun --show-sdk-path)",
      "Bash(codesign -d:*)",
      "Bash(codesign --verify:*)",
      "Bash(nm -gU:*)",
      "Bash(lipo -archs:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag -s:*)",
      "Bash(xcodebuild archive:*)",
      "Bash(xcrun notarytool:*)",
      "Bash(scripts/release-standalone.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(xcode-select -s:*)",
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)"
    ]
  }
}
